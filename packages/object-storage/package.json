{
  "name": "@swafford-workspace/object-storage",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Backblaze B2 / S3 client for workspace apps and the media worker.",
  "type": "module",
  "files": ["dist", "src"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
