    "typecheck": "tsc --noEmit",
    "prepare": "tsc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "typescript-7": "catalog:"
  }
}
