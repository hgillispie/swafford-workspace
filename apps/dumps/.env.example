# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# Private Backblaze B2 bucket. The three values below are not secret.
# Set the key id and application key on the Netlify site and in the
# workspace root environment. Do not commit those two.
B2_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET=swafford-video-dumps
# B2_KEY_ID=
# B2_APPLICATION_KEY=
