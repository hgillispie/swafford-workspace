# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# Private Backblaze B2 bucket. Set these on the Netlify site and in the
# workspace root environment. Do not commit values.
# B2_S3_ENDPOINT=
# B2_REGION=
# B2_BUCKET=
# B2_KEY_ID=
# B2_APPLICATION_KEY=
