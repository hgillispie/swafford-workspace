# Custom health check message
PING_MESSAGE=pong

# Bearer token Brandbot sends to pulse-ingest. Prefer the Dispatch vault.
# Do not commit a real value. Unauthenticated POSTs also accept this deploy env name.
# PULSE_INGEST_SECRET=

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true
