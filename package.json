{
  "name": "swafford-workspace",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "agent-native dev",
    "build": "pnpm -r build",
    "prebuild": "agent-native doctor --strict",
    "doctor": "agent-native doctor",
    "agent-native:doctor": "agent-native doctor",
    "typecheck": "pnpm -r typecheck",
    "repair:workspace-org": "tsx scripts/repair-workspace-org.ts",
    "skills:update": "agent-native skills update scaffold --project",
    "upgrade:agent-native": "agent-native upgrade",
    "fmt:check": "oxfmt --check .",
    "lint": "pnpm fmt:check",
    "postinstall": "pnpm --filter ./packages/creative-context build && pnpm --filter ./packages/embedding build"
  },
  "dependencies": {
    "@agent-native/core": "0.200.0",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "oxfmt": "catalog:",
    "tsx": "catalog:",
    "typescript-7": "catalog:"
  },
  "packageManager": "pnpm@10.29.1",
  "pnpm": {
    "patchedDependencies": {
      "@agent-native/core@0.200.0": "patches/@agent-native__core@0.200.0.patch"
    }
  },
  "agent-native": {
    "workspaceCore": "@swafford-workspace/shared",
    "builtinAgents": {
      "mode": "selected",
      "include": [
        "dispatch",
        "chat",
        "content",
        "brain",
        "assets",
        "slides",
        "analytics",
        "clips",
        "design",
        "plan"
      ]
    }
  }
}
