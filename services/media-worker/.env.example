# Copy to services/media-worker/.env.local (gitignored). Do not put real keys here.
# Used by `pnpm worker:dev` and `docker compose`.

WORKER_LAUNCHER=local
DATABASE_URL=postgres://user:pass@host/db
B2_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET=swafford-video-dumps
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_FORCE_PATH_STYLE=
B2_SSE=
# Production: leave TRANSCRIPTION_PROVIDER unset and set the two lines below.
# The Opus app on Netlify holds the Builder private key.
# MEDIA_APP_TRANSCRIBE_URL=https://<netlify-site>/opus/api/worker/transcribe
# MEDIA_WORKER_SECRET=
TRANSCRIPTION_PROVIDER=whisper
# Optional direct Builder path. Not used when MEDIA_APP_TRANSCRIBE_URL is set
# unless TRANSCRIPTION_PROVIDER=builder.
BUILDER_PRIVATE_KEY=
MEDIA_WORKDIR=/tmp/media-worker
# Minutes of an empty queue before the process exits. 0 stays up.
MEDIA_WORKER_IDLE_MINUTES=5
